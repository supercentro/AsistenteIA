# Role bootstrap settings (read ONLY by the "bootstrap" one-shot service). Copy to backend/.env.roles
# (git-ignored) and replace every CHANGE_ME. This is the one application file that holds the database
# administrator credential and the passwords of all four working roles; no other service receives it.
# Administrator URL: same user and password as POSTGRES_USER/POSTGRES_PASSWORD in backend/.env.db, on
# the "postgres" maintenance database (roles are cluster objects).
ADMIN_DATABASE_URL=postgresql+psycopg://asistente:CHANGE_ME@db:5432/postgres
# Passwords of the working roles, at least 16 characters and all different. Generate each with:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
# They must equal the passwords inside the URLs of backend/.env (application), .env.worker (worker),
# .env.migrate (migrator) and .env.cli (the administrative command).
DB_MIGRATOR_PASSWORD=CHANGE_ME
DB_APP_PASSWORD=CHANGE_ME
DB_WORKER_PASSWORD=CHANGE_ME
DB_CLI_PASSWORD=CHANGE_ME
