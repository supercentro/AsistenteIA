# Ingestion worker settings (read by the "worker" compose service: python -m app.worker).
# Copy to backend/.env.worker (git-ignored) and replace CHANGE_ME. The worker holds no API secret:
# never add JWT_SECRET, CORS or rate-limit variables here.

# Application
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Seconds allowed to open a PostgreSQL connection (1-60).
DB_CONNECT_TIMEOUT_SECONDS=5
# Host "db" is the docker compose service name. The user is the restricted role `asistente_worker` created by
# `db-bootstrap`; the password is DB_WORKER_PASSWORD of backend/.env.roles. NEVER the administrator
# (POSTGRES_USER of .env.db): the worker refuses to start as a superuser.
DATABASE_URL=postgresql+psycopg://asistente_worker:CHANGE_ME@db:5432/asistenteia

# Document ingestion, worker side (change 6). The values shown are the defaults approved after the spike; every one can be omitted.
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=2000
# Job age before JOB_EXPIRED.
INGESTION_JOB_MAX_AGE_HOURS=24
# Attempts, lease (renewed by a heartbeat), per-attempt deadline (greater than the lease) and embedding batch size.
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=120
INGESTION_JOB_DEADLINE_SECONDS=600
INGESTION_BATCH_SIZE=16
# Isolated PDF child process (Linux only): memory, CPU time, wall clock and output cap.
PDF_CHILD_MAX_MEMORY_MB=768
PDF_CHILD_CPU_SECONDS=20
PDF_CHILD_TIMEOUT_SECONDS=30
PDF_CHILD_MAX_OUTPUT_MB=8
# PostgreSQL timeouts applied by the worker engine (the API engine has its own in backend/.env).
DB_STATEMENT_TIMEOUT_WORKER_SECONDS=60
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=30
# Embedder: "local" (default) or "fake". "fake" is accepted only with APP_ENV=test, or with ALLOW_FAKE_EMBEDDER=true outside production.
EMBEDDER_BACKEND=local
ALLOW_FAKE_EMBEDDER=false
# Test-only. The worker refuses to start as a PostgreSQL superuser; this exception is rejected unless APP_ENV=test.
ALLOW_SUPERUSER_DATABASE_ROLE=false
EMBEDDING_MODEL_PATH=/opt/models/paraphrase-multilingual-MiniLM-L12-v2
# Inference threads. Leave unset to follow the CPU quota of the container (a wrong value makes inference much slower).
# EMBEDDING_THREADS=
