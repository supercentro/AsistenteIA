# Migration service settings (read by the Alembic one-shot "migrate" service of docker-compose, and by
# `alembic` when you run it by hand). Copy to backend/.env.migrate (git-ignored) and replace CHANGE_ME.
# It holds only the credential of the migrator role: no API, worker or administrator setting.
# Deliberately NOT called DATABASE_URL: running a migration with the API environment fails instead of
# silently using another credential. Created by the role bootstrap (backend/.env.roles).
# Host "db" is the docker compose service name; use "localhost" or "127.0.0.1:5442" from the host.
MIGRATION_DATABASE_URL=postgresql+psycopg://asistente_migrator:CHANGE_ME@db:5432/asistenteia
