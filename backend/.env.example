# API settings (read by the "backend" compose service). The ingestion worker has its own file,
# backend/.env.worker (see .env.worker.example), the database container has backend/.env.db, and the
# migration service, the role bootstrap and the host-only tests have .env.migrate, .env.roles and .env.test.

# Application
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Seconds allowed to open a PostgreSQL connection (1-60). Keeps /health from hanging on an unreachable database.
DB_CONNECT_TIMEOUT_SECONDS=5
# Host "db" is the docker compose service name. Use "localhost" when running the backend outside Docker.
# The user is the restricted role `asistente_app` created by `db-bootstrap`; the password is DB_APP_PASSWORD of
# backend/.env.roles. NEVER the administrator (POSTGRES_USER of .env.db): the API refuses to start as a superuser.
DATABASE_URL=postgresql+psycopg://asistente_app:CHANGE_ME@db:5432/asistenteia
# Explicit and mandatory (no wildcard) when APP_ENV=production. Defaults to http://localhost:5173 in development.
CORS_ORIGINS=http://localhost:5173

# Authentication (required). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 bytes; placeholders and low-variety values are rejected in every environment.
# Only the API reads it: never copy it into backend/.env.worker or backend/.env.db.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=asistenteia
JWT_AUDIENCE=asistenteia-api
JWT_EXPIRE_MINUTES=60
# Current privacy-policy version users must accept. Mirror it in frontend/src/lib/privacyPolicy.ts.
PRIVACY_POLICY_VERSION=2026-10-v1
# Login attempts per client address (in memory, per process). Format: "<n>/<second|minute|hour>".
LOGIN_RATE_LIMIT=10/minute
# Registrations per client address (same mechanism and limitations as login). Format as above.
REGISTER_RATE_LIMIT=5/minute

# Document ingestion, API side (change 6). The values shown are the defaults approved after the spike; every one can be omitted.
# The settings of the worker (limits of the PDF child, lease, attempts, embedder) are in backend/.env.worker.
# Upload limits. MAX_UPLOAD_MB is measured on the bytes actually received (1-100).
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_SUBJECT=50
# Queue: unfinished jobs, their total size (must be at least MAX_UPLOAD_MB) and uploads being received.
INGESTION_QUEUE_MAX=100
INGESTION_PENDING_BYTES_MAX_MB=200
UPLOAD_MAX_IN_FLIGHT=4
# Uploads per client address (in memory, per process). Format: "<n>/<second|minute|hour>".
UPLOAD_RATE_LIMIT=10/minute
# Whole-body deadline and longest silence while the body is received (the idle gap cannot exceed the deadline).
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_BODY_IDLE_SECONDS=20
# PostgreSQL timeouts applied by the API engine (the worker engine has its own in backend/.env.worker).
DB_STATEMENT_TIMEOUT_API_SECONDS=15
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=30

# Chat / RAG (change chat-rag-endpoint). Gemini LLM for grounded answers.
# Required when LLM_BACKEND=gemini (the default). Get it from Google AI Studio.
GOOGLE_API_KEY=CHANGE_ME
# gemini | fake. "fake" accepted only with APP_ENV=test or ALLOW_FAKE_LLM=true outside production.
LLM_BACKEND=gemini
# Set to true to allow LLM_BACKEND=fake in development (never in production).
# ALLOW_FAKE_LLM=false
# Gemini model identifier. Default: gemini-3.1-flash-lite
# (gemini-2.5-flash and gemini-2.5-flash-lite answer 404 "no longer available to new users".)
CHAT_LLM_MODEL=gemini-3.1-flash-lite
# Timeout for a single LLM call in seconds (5-120). Default: 30
CHAT_LLM_TIMEOUT_SECONDS=30
# Top-K chunks retrieved per query (1-50). Default: 5
CHAT_TOP_K=5
# Minimum cosine similarity to include a chunk (0.0-1.0). Default: 0.3
CHAT_RELEVANCE_THRESHOLD=0.3
# Previous messages included in the LLM prompt (0-50). Default: 10
CHAT_HISTORY_MESSAGES=10
# Chat requests per client address (in memory, per process). Format: "<n>/<second|minute|hour>".
CHAT_RATE_LIMIT=20/minute
# Aggregate activity of a subject for its teacher (GET /subjects/{id}/activity). Keep it false
# until the privacy text, the legal review and the consent version are in place (see
# docs/backend-standards.md section 9). When false the route answers 404 to a teacher.
TEACHER_ACTIVITY_ENABLED=false
# Topics of the PDF material and their ranking (GET and PUT .../topics). Needs the setting above as
# well. Use it with fictitious data only while its open risks are not closed (docs/technical-debt.md).
TEACHER_TOPICS_ENABLED=false
# Embedder backend for the API process (the worker has its own in backend/.env.worker).
# local | fake. "local" is the default: requires the model files at EMBEDDING_MODEL_PATH.
# "fake" accepted only with APP_ENV=test or ALLOW_FAKE_EMBEDDER=true outside production.
# In Docker the model files are baked into the image; for local dev without the model, use "fake".
EMBEDDER_BACKEND=local
# Set to true to allow EMBEDDER_BACKEND=fake in development (never in production).
# ALLOW_FAKE_EMBEDDER=false
# Path to the embedding model directory. Set by the Dockerfile; override for local dev only.
# EMBEDDING_MODEL_PATH=/opt/models/paraphrase-multilingual-MiniLM-L12-v2

# Seed (python -m app.cli seed; development/test only). No defaults exist: set your own local values.
# SEED_TEACHER_EMAIL=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_EMAIL=
# SEED_STUDENT_PASSWORD=
# Integration tests: TEST_DATABASE_URL and the other host-only test variables moved to backend/.env.test
# (see .env.test.example). This file holds no test, administrator, migration or role-password variable.
