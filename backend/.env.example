# Application
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
# Seconds allowed to open a PostgreSQL connection (1-60). Keeps /health from hanging on an unreachable database.
DB_CONNECT_TIMEOUT_SECONDS=5
# Host "db" is the docker compose service name. Use "localhost" when running the backend outside Docker.
DATABASE_URL=postgresql+psycopg://asistente:CHANGE_ME@db:5432/asistenteia
# Explicit and mandatory (no wildcard) when APP_ENV=production. Defaults to http://localhost:5173 in development.
CORS_ORIGINS=http://localhost:5173

# Authentication (required). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 bytes; placeholders and low-variety values are rejected in every environment.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=asistenteia
JWT_AUDIENCE=asistenteia-api
JWT_EXPIRE_MINUTES=60
# Current privacy-policy version users must accept. Mirror it in frontend/src/lib/privacyPolicy.ts.
PRIVACY_POLICY_VERSION=2026-10-v1
# Login attempts per client address (in memory, per process). Format: "<n>/<second|minute|hour>".
LOGIN_RATE_LIMIT=10/minute
# Registrations per client address (same mechanism and limitations as login). Format as above.
REGISTER_RATE_LIMIT=5/minute

# Document ingestion (change 6). The values shown are the defaults approved after the spike; every one can be omitted.
# Upload limits. MAX_UPLOAD_MB is measured on the bytes actually received (1-100).
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=2000
MAX_DOCUMENTS_PER_SUBJECT=50
# Queue: unfinished jobs, their total size (must be at least MAX_UPLOAD_MB), uploads being received, and job age before JOB_EXPIRED.
INGESTION_QUEUE_MAX=100
INGESTION_PENDING_BYTES_MAX_MB=200
UPLOAD_MAX_IN_FLIGHT=4
INGESTION_JOB_MAX_AGE_HOURS=24
# Uploads per client address (in memory, per process). Format: "<n>/<second|minute|hour>".
UPLOAD_RATE_LIMIT=10/minute
# Whole-body deadline and longest silence while the body is received (the idle gap cannot exceed the deadline).
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_BODY_IDLE_SECONDS=20
# Worker: attempts, lease (renewed by a heartbeat), per-attempt deadline (greater than the lease) and embedding batch size.
INGESTION_MAX_ATTEMPTS=3
INGESTION_LEASE_SECONDS=120
INGESTION_JOB_DEADLINE_SECONDS=600
INGESTION_BATCH_SIZE=16
# Isolated PDF child process (Linux only): memory, CPU time, wall clock and output cap.
PDF_CHILD_MAX_MEMORY_MB=768
PDF_CHILD_CPU_SECONDS=20
PDF_CHILD_TIMEOUT_SECONDS=30
PDF_CHILD_MAX_OUTPUT_MB=8
# PostgreSQL timeouts applied by the API and the worker engines.
DB_STATEMENT_TIMEOUT_API_SECONDS=15
DB_STATEMENT_TIMEOUT_WORKER_SECONDS=60
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=30
# Embedder: "local" (default) or "fake". "fake" is accepted only with APP_ENV=test, or with ALLOW_FAKE_EMBEDDER=true outside production.
EMBEDDER_BACKEND=local
ALLOW_FAKE_EMBEDDER=false
EMBEDDING_MODEL_PATH=/opt/models/paraphrase-multilingual-MiniLM-L12-v2
# Inference threads. Leave unset to follow the CPU quota of the container (a wrong value makes inference much slower).
# EMBEDDING_THREADS=

# Seed (python -m app.cli seed; development/test only). No defaults exist: set your own local values.
# SEED_TEACHER_EMAIL=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_EMAIL=
# SEED_STUDENT_PASSWORD=

# Database container (read by the "db" compose service, not by the application)
POSTGRES_USER=asistente
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=asistenteia

# Integration tests ONLY (never read by the application). Must be a different database whose name ends in "_test".
# Tests run on the host, so the host is 127.0.0.1 (not "localhost": it may resolve to IPv6; docker compose publishes the db on 127.0.0.1:5442).
TEST_DATABASE_URL=postgresql+psycopg://asistente:CHANGE_ME@127.0.0.1:5442/asistenteia_test
