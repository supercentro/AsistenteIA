# Host-only test settings, read by the integration tests that run on your machine (pytest). Copy to
# backend/.env.test (git-ignored). NO container receives this file: the API, the worker and the database
# never see a test or administrator-for-tests variable.
# The tests run on the host, so the host is 127.0.0.1 (not "localhost": it may resolve to IPv6; docker
# compose publishes the db on 127.0.0.1:5442). The database name must end in "_test" and must differ from
# the one in DATABASE_URL of backend/.env (the guard compares with it, so backend/.env must still exist).
TEST_DATABASE_URL=postgresql+psycopg://asistente:CHANGE_ME@127.0.0.1:5442/asistenteia_test
# Administrator URL used by the role-bound tests to create and drop roles whose names start with the
# reserved test prefix. Same server as TEST_DATABASE_URL, maintenance database "postgres". The role-bound
# tests fail (they are not skipped) when it is missing.
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://asistente:CHANGE_ME@127.0.0.1:5442/postgres
