# PostgreSQL container settings (read only by the "db" compose service).
# Copy to backend/.env.db (git-ignored) and replace CHANGE_ME. The container never receives the API
# or worker settings. POSTGRES_USER is the database ADMINISTRATOR: it is also the user of ADMIN_DATABASE_URL in
# backend/.env.roles (bootstrap only). The API and the worker must NOT use it (they use asistente_app and
# asistente_worker); changing these values does not change an existing data volume (see the development guide).
POSTGRES_USER=asistente
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=asistenteia
