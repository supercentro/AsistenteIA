# PostgreSQL container settings (read only by the "db" compose service).
# Copy to backend/.env.db (git-ignored) and replace CHANGE_ME. The container never receives the API
# or worker settings. Keep these values equal to the ones inside DATABASE_URL of backend/.env and
# backend/.env.worker; changing them does not change an existing data volume (see the development guide).
POSTGRES_USER=asistente
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=asistenteia
