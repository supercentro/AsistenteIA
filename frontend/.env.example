# Public API base URL (the only frontend configuration; never put secrets here)
VITE_API_URL=http://localhost:8000/api/v1
# Public build-time switch of the teacher activity page. Keep it false until the privacy text, the
# legal review and the consent version are in place and finding F1 is decided (TD-069). It only hides
# the entry point: the backend setting TEACHER_ACTIVITY_ENABLED is the real control.
VITE_TEACHER_ACTIVITY_ENABLED=false
