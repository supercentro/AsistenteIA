FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/opt/venv/bin:$PATH"
WORKDIR /repo/backend
COPY repo/backend/pyproject.toml repo/backend/uv.lock repo/backend/.python-version ./
RUN uv sync --frozen --extra ingestion --no-install-project
COPY repo /repo
