+    assert result.no_cited_source_rate == round(22 / 36, 3)
+
+
+@pytest.mark.parametrize(
+    ("kwargs", "no_material", "uncited"),
+    [
+        ({"none": 4, "retrieved": 6, "cited": 7}, False, True),  # few without material
+        ({"none": 0, "retrieved": 6, "cited": 7}, False, True),  # none: told like few
+        ({"none": 5, "retrieved": 2, "cited": 7}, True, False),  # the difference is few
+        ({"none": 5, "retrieved": 0, "cited": 7}, True, False),
+        ({"none": 5, "retrieved": 6, "cited": 4}, True, False),  # few cited: the complement
+        ({"none": 6, "retrieved": 0, "cited": 0}, False, False),  # all alike
+    ],
+    ids=["few-none", "no-none", "few-retrieved", "no-retrieved", "few-cited", "all-none"],
+)
+def test_a_rate_needs_every_group_it_lets_a_reader_compute(
+    kwargs: dict[str, int], no_material: bool, uncited: bool
+) -> None:
+    result = sides(**kwargs)
+
+    assert (result.no_material_rate is not None) is no_material
+    assert (result.no_cited_source_rate is not None) is uncited
+
+
+@pytest.mark.parametrize("heavy_kind", ["none", "cited"])
+def test_a_side_that_one_student_concentrates_withholds_the_rate(heavy_kind: str) -> None:
+    repo = Repo()
+    balanced(repo, SECOND, people=8, each=4, kind="retrieved")
+    balanced(repo, SECOND, people=8, each=4, kind="cited" if heavy_kind == "none" else "none")
+    repo.ask(0, SECOND, 11, kind=heavy_kind)
+    for student in range(1, 6):
