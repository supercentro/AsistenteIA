diff --git a/frontend/src/components/ActivitySummary.tsx b/frontend/src/components/ActivitySummary.tsx
new file mode 100644
index 0000000..a35eeeb
--- /dev/null
+++ b/frontend/src/components/ActivitySummary.tsx
@@ -0,0 +1,67 @@
+import { formatDay } from '../lib/activityFormat'
+import { strings } from '../lib/strings.es'
+import type { ActivityResponse } from '../types/api'
+import { CitedDocumentsTable } from './CitedDocumentsTable'
+import { InsufficientData } from './InsufficientData'
+import { MetricCard } from './MetricCard'
+import { ShareBar } from './ShareBar'
+
+const text = strings.activity
+
+/** The response says how many weeks the block has; the summary may cover only some of them. */
+function coverage(weeks: string[], blockWeeks: number): string {
+  return weeks.length === blockWeeks
+    ? text.summary.allWeeks
+    : text.summary.someWeeks(weeks.map(formatDay).join(', '))
+}
+
+/** The figures of the latest complete block: cards, shares and cited documents. */
+export function ActivitySummary({ data }: { data: ActivityResponse }) {
+  const block = data.summary_window
+  const weeks = data.summary_weeks
+  return (
+    <section
+      aria-labelledby={block ? 'activity-summary' : undefined}
+      className="flex flex-col gap-3"
+    >
+      {block ? (
+        <>
+          <h2 id="activity-summary" className="text-lg font-semibold">
+            {text.summary.label(formatDay(block.start), formatDay(block.end))}
+          </h2>
+          {weeks ? <p className="text-sm text-slate-600">{coverage(weeks, block.weeks)}</p> : null}
+          <p className="text-sm text-slate-600">{text.summary.update}</p>
+        </>
+      ) : null}
+      <dl className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+        <MetricCard label={text.cards.enrolled}>{data.enrolled_students}</MetricCard>
+        <MetricCard label={text.cards.active}>
+          {data.active_students === null ? <InsufficientData /> : data.active_students}
+        </MetricCard>
+      </dl>
+      {weeks === null ? (
+        <p role="status" className="rounded-md border border-slate-300 bg-white p-4">
+          {text.summary.none}
+        </p>
+      ) : (
+        <>
+          <p className="text-sm text-slate-600">{text.cards.activeNote}</p>
+          <section aria-labelledby="activity-shares" className="flex flex-col gap-3">
+            <h3 id="activity-shares" className="text-lg font-semibold">
+              {text.shares.heading}
+            </h3>
+            <dl className="flex flex-col gap-4">
+              <ShareBar label={text.shares.noMaterial} share={data.no_material_rate} />
+              <ShareBar
+                label={text.shares.noCitedSource}
+                note={text.shares.noCitedSourceNote}
+                share={data.no_cited_source_rate}
+              />
+            </dl>
+          </section>
+          <CitedDocumentsTable documents={data.documents} />
+        </>
+      )}
+    </section>
+  )
+}
