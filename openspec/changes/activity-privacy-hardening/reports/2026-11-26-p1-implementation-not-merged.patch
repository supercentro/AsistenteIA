+def one_answer_citing_only_a_withheld_document() -> Repo:
+    """33 answers with both rates published; four of them cite two documents."""
+    repo = Repo({DOC_A: "a.pdf", DOC_B: "b.pdf", DOC_C: "c.pdf"})
+    balanced(repo, SECOND, people=8, each=2)
+    balanced(repo, SECOND, people=6, each=1, kind="none")
+    balanced(repo, SECOND, people=6, each=1, kind="retrieved")
+    for student in range(4):
+        repo.ask(student, SECOND, 1, answered=False)
+        both = (SourceFact(1, DOC_A, "a.pdf"), SourceFact(2, DOC_B, "b.pdf"))
+        when = repo.asked[-1].asked_at
+        repo.answered.append(AnswerFact(PEOPLE[student], when, "Respuesta ficticia [1][2].", both))
+    repo.ask(4, SECOND, 1, doc=DOC_C)
+    return repo
