@@ -0,0 +1,222 @@
+"""An exhaustive composition adversary of the teacher activity.
+
+Change `activity-privacy-hardening`.
+
+The tests that named a scenario each did not find the leaks of composition, because they only looked
+where somebody had already thought of looking. This one takes a response and enumerates **every**
+world of answer types that is consistent with it: an answer without material, one that only
+retrieved, or one that cites a set of the current documents. A quantity that has the same value in
+all of those worlds is known to the reader.
+
+It knows: the published cells of the covered weeks, both rates, the document figures, the
+documents that exist and how many documents an answer cites at most. It reports the quantities that
+are determined although they come from students who may not make a figure (fewer than the minimum,
+or one above the dominance share). It is exact for the model, not a proof about other knowledge:
+padding with accounts, comparisons between reads and what the reader knows from outside are not in
+it.
+"""
+
+import random
+import uuid
+from collections.abc import Iterator, Sequence
+from datetime import UTC, datetime
+from itertools import combinations
+from typing import Any
+
+from app.repositories.activity_repository import AnswerFact, QuestionFact, SourceFact
+from app.services.activity_service import _publishable
+
+WHEN = datetime(2026, 3, 24, 10, tzinfo=UTC)  # inside the block that the tests read
+DOCUMENTS = [uuid.UUID(int=number) for number in (1, 2, 3)]
+MATERIAL_NONE, RETRIEVED = "M", "R"
+Type = str | frozenset[uuid.UUID]  # an answer without citation, or the documents it cites
+Row = tuple[uuid.UUID, str, tuple[uuid.UUID, ...]]  # student, "none"/"retrieved"/"cited", sources
+
+
+def facts(rows: Sequence[Row]) -> tuple[list[QuestionFact], list[AnswerFact]]:
+    answers = []
+    for student, kind, documents in rows:
+        sources = tuple(SourceFact(rank, key, "x.pdf") for rank, key in enumerate(documents, 1))
+        marks = "".join(f"[{s.rank}]" for s in sources) if kind == "cited" else ""
+        answers.append(AnswerFact(student, WHEN, f"answer {marks}", sources))
+    return [QuestionFact(a.student_id, a.answered_at) for a in answers], answers
+
+
+def random_class(rng: random.Random, max_cites: int, mixed: bool = False) -> list[Row]:
+    """A small class in one week.
+
+    With `mixed` every student has answers of every kind, so that both rates are often published and
+    their interactions are exercised; otherwise the mix of kinds varies from class to class, so
+    that each side is sometimes the small one.
+    """
+    # With one citation per answer the enumeration is cheap enough for larger classes, where three
+    # groups of five students can exist at once.
+    largest, most = (11, 30) if max_cites == 1 else (7, 17)
+    students = [uuid.UUID(int=1000 + n) for n in range(rng.randint(6 if mixed else 5, largest))]
+    weights = [rng.choice([1, 3, 8]) for _ in DOCUMENTS]
+    none_share = 0.33 if mixed else rng.choice([0.05, 0.18, 0.6])
+    retrieved_share = 0.28 if mixed else rng.choice([0.05, 0.18, 0.5])
+    rows: list[Row] = []
+    for student in students:
+        for _ in range(rng.choice([2, 3, 3] if mixed else [1, 1, 2, 2, 3])):
+            if len(rows) >= most:
+                break
+            draw = rng.random()
+            if draw < none_share:
+                rows.append((student, "none", ()))
+            elif draw < none_share + retrieved_share:
+                rows.append((student, "retrieved", (rng.choices(DOCUMENTS, weights)[0],)))
+            else:
+                size = 1 if max_cites == 1 or rng.random() < 0.75 else 2
+                cited = {rng.choices(DOCUMENTS, weights)[0] for _ in range(size)}
+                rows.append((student, "cited", tuple(sorted(cited))))
+    return rows
+
+
+def _solutions(
+    types: Sequence[Type], total: int, equations: Sequence[tuple[set[Type], int]]
+) -> Iterator[list[int]]:
+    """Every non-negative count per type that adds to `total` and satisfies the equations."""
+    values = [0] * len(types)
+    member = [[kind in group for group, _ in equations] for kind in types]
+    left = [value for _, value in equations]
+    later = [
+        [any(member[j][e] for j in range(i, len(types))) for e in range(len(equations))]
+        for i in range(len(types) + 1)
+    ]
+
+    def walk(i: int, rest: int) -> Iterator[list[int]]:
+        if any(left[e] and not later[i][e] for e in range(len(equations))):
+            return
+        if i == len(types):
+            if rest == 0 and not any(left):
+                yield list(values)
+            return
+        for value in [rest] if i == len(types) - 1 else range(rest + 1):
+            if any(member[i][e] and value > left[e] for e in range(len(equations))):
+                continue
+            for e in range(len(equations)):
+                if member[i][e]:
+                    left[e] -= value
+            values[i] = value
+            yield from walk(i + 1, rest - value)
+            for e in range(len(equations)):
+                if member[i][e]:
+                    left[e] += value
+            values[i] = 0
+
+    yield from walk(0, total)
+
+
+def _targets(
+    rows: Sequence[Row], result: Any, max_cites: int
+) -> dict[str, tuple[set[Type], list[uuid.UUID]]]:
+    """Each quantity the adversary wants: the types it adds up and the students behind its truth."""
+    cited_types: list[Type] = [
+        frozenset(c) for size in range(1, max_cites + 1) for c in combinations(DOCUMENTS, size)
+    ]
+    types: set[Type] = {MATERIAL_NONE, RETRIEVED, *cited_types}
+    cited = [row for row in rows if row[1] == "cited"]
+    shown = {d.document_id for d in result.documents if d.cited_appearances is not None}
+    hidden = [d for d in DOCUMENTS if d not in shown]
+
+    def students(chosen: Sequence[Row]) -> list[uuid.UUID]:
+        return [row[0] for row in chosen]
+
+    def citing(keys: Sequence[uuid.UUID]) -> set[Type]:
+        return {t for t in cited_types if set(keys) & set(t)}
+
+    none = [row for row in rows if row[1] == "none"]
+    retrieved = [row for row in rows if row[1] == "retrieved"]
+    found: dict[str, tuple[set[Type], list[uuid.UUID]]] = {
+        "retrieved-only answers": ({RETRIEVED}, students(retrieved)),
+        "cited answers": (set(cited_types), students(cited)),
+    }
+    # A published rate gives both of its sides away: each side is a target whether or not it is.
+    found["answers without material"] = ({MATERIAL_NONE}, students(none))
+    found["answers with material"] = (
+        {RETRIEVED, *cited_types},
+        students(retrieved + cited),
+    )
+    found["uncited answers"] = ({MATERIAL_NONE, RETRIEVED}, students(none + retrieved))
+    for number, document in enumerate(hidden):
+        found[f"hidden document {number}"] = (
+            citing([document]),
+            students([row for row in cited if document in row[2]]),
+        )
+    if hidden:
+        found["answers citing a hidden document"] = (
+            citing(hidden),
+            students([row for row in cited if set(row[2]) & set(hidden)]),
+        )
+    published = sorted(shown)
+    if published:  # answers that had material and cite none of the published documents
+        outside = [
+            row
+            for row in rows
+            if row[1] == "retrieved" or (row[1] == "cited" and not set(row[2]) & shown)
+        ]
+        found["with material outside documents"] = (
+            {RETRIEVED, *(set(cited_types) - citing(published))},
+            students(outside),
+        )
+    for size in range(1, len(published) + 1):
+        for number, group in enumerate(combinations(published, size)):
+            rest = [row for row in rows if not (row[1] == "cited" and set(row[2]) & set(group))]
+            found[f"complement of documents {size}.{number}"] = (
+                types - citing(group),
+                students(rest),
+            )
+            found[f"cited outside documents {size}.{number}"] = (
+                set(cited_types) - citing(group),
+                students([row for row in rest if row[1] == "cited"]),
+            )
+    return found
+
+
+def determined(rows: Sequence[Row], result: Any, max_cites: int) -> set[str]:
+    """The names (without numbers) of the quantities of few students that the response fixes.
+
+    A name that starts with "none: " is a quantity fixed to zero: the reader learns that nobody is
+    in that group, which the convention of this feature does not tell apart from "few".
+    """
+    if result.summary_weeks is None:
+        return set()
+    cited_types: list[Type] = [
+        frozenset(c) for size in range(1, max_cites + 1) for c in combinations(DOCUMENTS, size)
+    ]
+    types: list[Type] = [MATERIAL_NONE, RETRIEVED, *cited_types]
+    total = len(rows)
+    equations: list[tuple[set[Type], int]] = []
+    if result.no_material_rate is not None:
+        equations.append(({MATERIAL_NONE}, round(result.no_material_rate * total)))
+    if result.no_cited_source_rate is not None:
+        equations.append(({MATERIAL_NONE, RETRIEVED}, round(result.no_cited_source_rate * total)))
+    for document in result.documents:
+        if document.cited_appearances is not None:
+            group = {t for t in cited_types if document.document_id in t}
+            equations.append((group, document.cited_appearances))
+
+    wanted = {
+        name: (group, behind)
+        for name, (group, behind) in _targets(rows, result, max_cites).items()
+        if not behind or not _publishable(behind)
+    }
+    values: dict[str, set[int]] = {name: set() for name in wanted}
+    alive = set(wanted)
+    consistent = False
+    for solution in _solutions(types, total, equations):
+        consistent = True
+        for name in list(alive):
+            group = wanted[name][0]
+            values[name].add(sum(v for t, v in zip(types, solution, strict=True) if t in group))
+            if len(values[name]) > 1:
+                alive.discard(name)
+        if not alive:
+            break
+    assert consistent or not wanted, "no world is consistent with the response"
+    return {
+        ("" if wanted[name][1] else "none: ") + name.rstrip(" .0123456789")
+        for name in alive
+        if values[name]
+    }
