+def test_a_heavy_student_among_those_citing_withheld_documents_withholds_the_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=9, each=6, doc=DOC_A)
+    balanced(repo, SECOND, people=6, each=3, kind="retrieved")
+    repo.ask(0, SECOND, 6, doc=DOC_B)
+    balanced(repo, SECOND, people=5, each=1, doc=DOC_B)  # one holds 7 of the 11 citations of B
+
+    result = read(repo)
+
+    assert figure(result, DOC_B) is None
+    assert result.no_cited_source_rate is None
+
+
+def sides(*, none: int, retrieved: int, cited: int) -> Any:
+    """Students (2 answers each) of each kind; the same students may have several kinds."""
+    repo = Repo()
+    balanced(repo, SECOND, people=none, kind="none")
+    balanced(repo, SECOND, people=retrieved, kind="retrieved")
+    balanced(repo, SECOND, people=cited)
+    return read(repo)
+
+
+def test_rates_are_published_when_every_group_they_open_is_publishable() -> None:
+    result = sides(none=5, retrieved=6, cited=7)
