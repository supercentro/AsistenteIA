index 0000000..dd7c3a4
--- /dev/null
+++ b/backend/tests/unit/test_activity_composition.py
@@ -0,0 +1,703 @@
+"""P1 of `activity-privacy-hardening`: fixed blocks, rule F, dominance and rule G2.
+
+The service runs over an in-memory repository; the SQL and the real deletion of a document are in
+`tests/integration/test_activity_composition_db.py`. Fictitious data only. Every random property
+counts the cases that trigger it, so that it cannot pass without having tested anything.
+"""
+
+# The generators are seeded test data, never a secret: S311 does not apply to this module.
+# ruff: noqa: S311
+
+import random
+import uuid
+from datetime import UTC, date, datetime, timedelta
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+from app.repositories.activity_repository import AnswerFact, QuestionFact, SourceFact
+from app.services.activity_service import ActivityService, ended_weeks_today
+
+ANCHOR = date(2026, 1, 5)  # a Monday, common to every subject
+TODAY = date(2026, 3, 30)  # the latest complete block is 2026-03-16 .. 2026-03-29
+OLD = date(2026, 3, 2)  # a week of the series, before the block
+FIRST = date(2026, 3, 16)  # the first week of the block
+SECOND = date(2026, 3, 23)
+WINDOW = {"start": OLD, "end": date(2026, 3, 29)}
+TEACHER = uuid.uuid4()
+SUBJECT = uuid.uuid4()
+DOC_A, DOC_B, DOC_C = (uuid.UUID(int=n) for n in (1, 2, 3))
+PEOPLE = [uuid.UUID(int=100 + n) for n in range(40)]
+CITED, PLAIN = "Respuesta ficticia [1].", "Respuesta ficticia sin marcas."
+
+
+class Repo:
+    """The filters of the real repository: enrolled students only, half-open window."""
+
+    def __init__(self, documents: dict[uuid.UUID, str] | None = None) -> None:
+        self.documents = documents if documents is not None else {DOC_A: "a.pdf"}
+        self.asked: list[QuestionFact] = []
+        self.answered: list[AnswerFact] = []
+        self.gone: set[uuid.UUID] = set()  # removed from the subject
+        self.enrolled = len(PEOPLE)
+
+    def enrolled_count(self, **_: object) -> int:
+        return self.enrolled
+
+    def questions(self, *, start: datetime, end: datetime, **_: object) -> list[QuestionFact]:
+        return [
+            q for q in self.asked if start <= q.asked_at < end and q.student_id not in self.gone
+        ]
+
+    def answers(self, *, start: datetime, end: datetime, **_: object) -> list[AnswerFact]:
+        return [
+            a
+            for a in self.answered
+            if start <= a.answered_at < end and a.student_id not in self.gone
+        ]
+
+    def current_documents(self, **_: object) -> list[tuple[uuid.UUID, str]]:
+        return sorted(self.documents.items(), key=lambda item: (item[1], str(item[0])))
+
+    def ask(
+        self,
+        student: int,
+        week: date,
+        times: int = 1,
+        *,
+        doc: uuid.UUID | None = DOC_A,
+        kind: str = "cited",
+        answered: bool = True,
+        name: str | None = None,
+        day: int = 1,
+    ) -> None:
+        """`doc=None` is a source whose document was deleted: only the file name remains."""
+        when = datetime(week.year, week.month, week.day, 10, tzinfo=UTC) + timedelta(days=day)
+        filename = name or self.documents.get(doc, "gone.pdf") if doc else name or "gone.pdf"
+        for _ in range(times):
+            self.asked.append(QuestionFact(student_id=PEOPLE[student], asked_at=when))
+            if not answered:
+                continue
+            listed = doc if doc in self.documents else None
+            sources = () if kind == "none" else (SourceFact(1, listed, filename),)
+            content = CITED if kind == "cited" else PLAIN
+            self.answered.append(AnswerFact(PEOPLE[student], when, content, sources))
+
+    def delete(self, document: uuid.UUID) -> None:
+        """What the database does: the chunks go, the sources keep the name and lose the id."""
+        self.documents = {k: v for k, v in self.documents.items() if k != document}
+        self.answered = [
+            AnswerFact(
+                a.student_id,
+                a.answered_at,
+                a.content,
+                tuple(
+                    SourceFact(
+                        s.rank, None if s.document_id == document else s.document_id, s.filename
+                    )
+                    for s in a.sources
+                ),
+            )
+            for a in self.answered
+        ]
+
+
+class Subjects:
+    def __init__(self, marker: datetime | None = None) -> None:
+        self.marker = marker
+
+    def get_for_teacher(self, *_: object) -> object:
+        return SimpleNamespace(last_unenrolment_at=self.marker)
+
+
+def read(
+    repo: Repo,
+    *,
+    today: date = TODAY,
+    marker: datetime | None = None,
+    subject: uuid.UUID = SUBJECT,
+    **window: date,
+) -> Any:
+    service = ActivityService(Subjects(marker), repo, today=lambda: today)  # type: ignore[arg-type]
+    return service.get(TEACHER, subject, **(window or WINDOW))
+
+
+def balanced(repo: Repo, week: date, people: int = 5, each: int = 2, **kwargs: Any) -> None:
+    for student in range(people):
+        repo.ask(student, week, each, **kwargs)
+
+
+def summary(result: Any) -> tuple[Any, ...]:
+    return (
+        result.summary_window and result.summary_window.start,
+        result.summary_weeks,
+        result.active_students,
+        result.no_material_rate,
+        result.no_cited_source_rate,
+        [(d.filename, d.document_id, d.cited_appearances) for d in result.documents],
+    )
+
+
+def figure(result: Any, document: uuid.UUID) -> int | None:
+    value: int | None = next(
+        d.cited_appearances for d in result.documents if d.document_id == document
+    )
+    return value
+
+
+def cell(result: Any, week: date) -> int | None:
+    value: int | None = next(p.count for p in result.questions if p.period_start == week)
+    return value
+
+
+# --- the blocks (V3) --------------------------------------------------------------------------
+
+
+def test_the_summary_is_the_latest_complete_block_aligned_to_the_anchor() -> None:
+    for today, start in (
+        (date(2026, 3, 30), date(2026, 3, 16)),
+        (date(2026, 4, 5), date(2026, 3, 16)),  # the next block has one week left
+        (date(2026, 4, 13), date(2026, 3, 30)),
+        (date(2025, 12, 31), date(2025, 12, 8)),  # before the anchor
+    ):
+        result = read(Repo(), today=today, start=today - timedelta(days=60), end=today)
+        window = result.summary_window
+        assert (window.start, window.end, window.weeks) == (start, start + timedelta(days=13), 2)
+        assert (start - ANCHOR).days % 14 == 0
+
+
+def test_a_block_appears_one_hour_after_its_sunday_and_not_before() -> None:
+    before = ended_weeks_today(datetime(2026, 3, 30, 0, 59, 59, tzinfo=UTC))
+    after = ended_weeks_today(datetime(2026, 3, 30, 1, 0, 0, tzinfo=UTC))
+
+    assert read(Repo(), today=before, end=before).summary_window.start == date(2026, 3, 2)
+    assert read(Repo(), today=after, end=after).summary_window.start == FIRST
+
+
+def test_two_subjects_have_the_same_blocks() -> None:
+    blocks = {
+        read(Repo(), subject=uuid.UUID(int=number)).summary_window.start for number in range(20)
+    }
+
+    assert blocks == {FIRST}
+
+
+def test_start_and_end_have_no_effect_on_the_summary() -> None:
+    repo = Repo()
+    balanced(repo, OLD, people=9)
+    balanced(repo, FIRST)
+    balanced(repo, SECOND, people=6)
+    expected = summary(read(repo))
+
+    for start, end in (
+        (date(2026, 1, 5), date(2026, 3, 29)),
+        (OLD, date(2026, 3, 8)),  # a window that does not contain the block
+        (FIRST, date(2026, 3, 22)),  # half of the block
+        (SECOND, date(2026, 12, 31)),
+    ):
+        assert summary(read(repo, start=start, end=end)) == expected
+    assert expected[2] == 6
+
+
+def test_a_request_without_a_whole_week_shows_no_summary() -> None:
+    repo = Repo()
+    balanced(repo, SECOND)
+
+    result = read(repo, start=date(2026, 3, 30), end=date(2026, 4, 5))
+
+    assert result.window.weeks == 0
+    assert result.summary_window is None and result.summary_weeks is None
+    assert result.active_students is None and result.suppressed
+
+
+def test_a_block_that_starts_before_the_marker_is_withheld_whole_never_trimmed() -> None:
+    repo = Repo()
+    balanced(repo, FIRST)
+    balanced(repo, SECOND)
+    inside = datetime(2026, 3, 18, tzinfo=UTC)  # a removal during the first week of the block
+
+    result = read(repo, marker=inside)
+
+    assert result.window.weeks == 1  # the series still shows the second week (A2)
+    assert cell(result, SECOND) == 10
+    assert result.summary_window is None and result.summary_weeks is None
+    assert result.active_students is None and result.no_material_rate is None
+    assert result.no_cited_source_rate is None
+    assert [d.cited_appearances for d in result.documents] == [None]
+
+
+def test_a_later_read_has_a_disjoint_block() -> None:
+    first = read(Repo(), today=TODAY).summary_window
+    later = read(
+        Repo(), today=TODAY + timedelta(days=14), end=TODAY + timedelta(days=14)
+    ).summary_window
+
+    assert later.start > first.end
+
+
+def test_no_block_is_ever_shown_in_two_versions() -> None:
+    """Reads, removals and re-enrolments over 20 weeks. Counts what triggers the property."""
+    versions_seen = removals = withheld = 0
+    for seed in range(30):
+        rng = random.Random(seed)
+        repo = Repo()
+        for week in range(20):
+            for student in range(8):
+                if rng.random() < 0.85:
+                    repo.ask(student, ANCHOR + timedelta(weeks=week), rng.randint(1, 3))
+        marker: datetime | None = None
+        shown: dict[date, Any] = {}
+        for week in range(2, 21):
+            today = ANCHOR + timedelta(weeks=week, days=rng.randint(0, 6))
+            action = rng.random()
+            if action < 0.12 and len(repo.gone) < 3:
+                leaving = PEOPLE[rng.randrange(8)]
+                repo.gone.add(leaving)
+                marker = datetime(today.year, today.month, today.day, tzinfo=UTC)
+                removals += 1
+                # A removed student cannot ask (the chat takes the same lock as the removal).
+                repo.asked = [
+                    q for q in repo.asked if q.student_id != leaving or q.asked_at < marker
+                ]
+                repo.answered = [
+                    a for a in repo.answered if a.student_id != leaving or a.answered_at < marker
+                ]
+            elif action < 0.18 and repo.gone:
+                back = PEOPLE.index(repo.gone.pop())  # enrolled again: only new questions follow
+                for later in range(week + 1, 20):
+                    repo.ask(back, ANCHOR + timedelta(weeks=later), rng.randint(1, 3))
+            result = read(repo, today=today, marker=marker, end=today)
+            if result.summary_window is None:
+                withheld += 1
+                continue
+            start = result.summary_window.start
+            figures = summary(result)[1:5]
+            if start in shown:
+                versions_seen += 1
+                assert shown[start] == figures, (seed, week)
+            shown[start] = figures
+    assert versions_seen >= 50 and removals >= 20 and withheld >= 20
+
+
+def test_the_summary_never_covers_a_week_outside_its_block() -> None:
+    """Even if the repository returned rows of other weeks, they would not enter the summary."""
+
+    class Unfiltered(Repo):
+        def questions(self, **_: object) -> list[QuestionFact]:
+            return self.asked
+
+        def answers(self, **_: object) -> list[AnswerFact]:
+            return self.answered
+
+    repo = Unfiltered()
+    balanced(repo, OLD, people=9)
+    balanced(repo, SECOND)
+
+    result = read(repo)
+
+    assert (result.summary_weeks, result.active_students) == ([SECOND], 5)
+    assert figure(result, DOC_A) == 10
+
+
+# --- rule F: only published weeks (V6a) --------------------------------------------------------
+
+
+def test_the_summary_covers_only_the_weeks_whose_cell_is_published() -> None:
+    repo = Repo()
+    balanced(repo, FIRST, people=4)
+    balanced(repo, SECOND, people=6)
+
+    result = read(repo)
+
+    assert result.summary_weeks == [SECOND]
+    assert (cell(result, FIRST), cell(result, SECOND)) == (None, 12)
+    assert result.active_students == 6
+    assert figure(result, DOC_A) == 12
+
+
+def test_both_weeks_are_covered_when_both_are_publishable() -> None:
+    repo = Repo()
+    balanced(repo, FIRST)
+    balanced(repo, SECOND, people=6)
+
+    result = read(repo)
+
+    assert result.summary_weeks == [FIRST, SECOND]
+    assert (result.active_students, figure(result, DOC_A)) == (6, 22)
+
+
+def withheld_week_world(variant: int, seed: int) -> Repo:
+    """Two variants of a seed differ only in the facts of the first week of the block, which
+    stays withheld in both: fewer than five students, or one student with most questions."""
+    common, other = random.Random(seed), random.Random(seed * 31 + variant)
+    repo = Repo({DOC_A: "a.pdf", DOC_B: "b.pdf"})
+    for week in (OLD, SECOND):
+        for student in range(common.randint(5, 8)):
+            repo.ask(
+                student,
+                week,
+                common.randint(1, 3),
+                doc=common.choice([DOC_A, DOC_B]),
+                kind=common.choice(["cited", "cited", "retrieved", "none"]),
+            )
+    if seed % 2:  # fewer than five students
+        for student in range(other.randint(1, 4)):
+            repo.ask(
+                student,
+                FIRST,
+                other.randint(1, 9),
+                doc=other.choice([DOC_A, DOC_B, None]),
+                kind=other.choice(["cited", "retrieved", "none"]),
+            )
+    else:  # a heavy student
+        for student in range(1, 5):
+            repo.ask(student, FIRST, 1, doc=other.choice([DOC_A, DOC_B]))
+        repo.ask(
+            0,
+            FIRST,
+            other.randint(10, 40),
+            doc=other.choice([DOC_A, DOC_B, None]),
+            kind=other.choice(["cited", "retrieved", "none"]),
+        )
+    return repo
+
+
+def test_the_response_does_not_depend_on_a_withheld_week() -> None:
+    differing = 0
+    for seed in range(60):
+        one, two = withheld_week_world(1, seed), withheld_week_world(2, seed)
+        first, second = read(one), read(two)
+        assert cell(first, FIRST) is None and cell(second, FIRST) is None
+        assert first.model_dump(mode="json") == second.model_dump(mode="json"), seed
+        differing += one.answered != two.answered
+    assert differing >= 55
+
+
+def test_the_denominator_of_the_rates_is_the_sum_of_the_published_cells() -> None:
+    repo = Repo()
+    balanced(repo, FIRST, people=4, each=7, kind="none")  # withheld
+    balanced(repo, SECOND, people=6, each=3)
+    balanced(repo, SECOND, people=5, each=1, kind="none")
+    balanced(repo, SECOND, people=5, each=1, kind="retrieved")
+
+    result = read(repo)
+
+    total = sum(cell(result, week) or 0 for week in result.summary_weeks)
+    assert total == 28
+    assert result.no_material_rate == round(5 / total, 3)
+    assert result.no_cited_source_rate == round(10 / total, 3)
+
+
+# --- an ended block does not change ------------------------------------------------------------
+
+
+def test_later_facts_never_change_an_ended_block() -> None:
+    repo = Repo()
+    balanced(repo, FIRST)
+    balanced(repo, SECOND)
+    before = summary(read(repo))
+
+    balanced(repo, date(2026, 3, 30), people=9, each=5)
+
+    assert summary(read(repo)) == before
+    assert summary(read(repo, today=date(2026, 4, 6))) == before  # still the latest block
+
+
+def test_an_erasure_gives_the_world_in_which_the_student_never_existed() -> None:
+    erased, never = Repo(), Repo()
+    for repo, people in ((erased, range(7)), (never, range(6))):
+        for student in people:
+            repo.ask(student, SECOND, 2)
+    erased.asked = [q for q in erased.asked if q.student_id != PEOPLE[6]]
+    erased.answered = [a for a in erased.answered if a.student_id != PEOPLE[6]]
+
+    assert read(erased).model_dump(mode="json") == read(never).model_dump(mode="json")
+
+
+# --- dominance (F6) ----------------------------------------------------------------------------
+
+
+def questions(counts: list[int]) -> Repo:
+    repo = Repo()
+    for student, times in enumerate(counts):
+        repo.ask(student, SECOND, times)
+    return repo
+
+
+def test_a_cell_that_one_student_concentrates_is_withheld() -> None:
+    assert cell(read(questions([50, 1, 1, 1, 1])), SECOND) is None
+    assert cell(read(questions([4, 1, 1, 1, 1])), SECOND) == 8  # exactly half is published
+    assert cell(read(questions([5, 1, 1, 1, 1])), SECOND) is None
+    assert cell(read(questions([3, 3, 2, 2, 2])), SECOND) == 12  # the true count, never capped
+
+
+@pytest.mark.parametrize(("heavy", "published"), [(4, True), (5, False)])
+def test_a_rate_is_withheld_when_one_student_holds_more_than_half_of_a_side(
+    heavy: int, published: bool
+) -> None:
+    repo = Repo()
+    balanced(repo, SECOND, people=8, each=4)
+    balanced(repo, SECOND, people=8, each=1, kind="retrieved")
+    repo.ask(0, SECOND, heavy, kind="none")
+    for student in range(1, 5):
+        repo.ask(student, SECOND, 1, kind="none")
+
+    result = read(repo)
+
+    assert cell(result, SECOND) == 40 + heavy + 4
+    assert (result.no_material_rate is not None) is published
+
+
+def test_a_document_that_one_student_concentrates_is_withheld_and_the_others_are_not() -> None:
+    repo = Repo({DOC_A: "a.pdf", DOC_B: "b.pdf"})
+    balanced(repo, SECOND, people=6, each=6, doc=DOC_A)
+    for student in range(5):
+        repo.ask(student, SECOND, 6 if student == 0 else 1, doc=DOC_B)
+
+    result = read(repo)
+
+    assert cell(result, SECOND) == 46
+    assert (figure(result, DOC_A), figure(result, DOC_B)) == (36, None)
+
+
+def test_which_student_is_the_heavy_one_does_not_change_the_response() -> None:
+    first = read(questions([50, 1, 1, 1, 1]))
+    second = read(questions([1, 1, 1, 50, 1]))
+
+    assert first.model_dump(mode="json") == second.model_dump(mode="json")
+
+
+def test_every_published_figure_is_the_true_count_of_the_covered_weeks() -> None:
+    published = 0
+    for seed in range(60):
+        rng = random.Random(seed)
+        repo = Repo({DOC_A: "a.pdf", DOC_B: "b.pdf"})
+        for week in (FIRST, SECOND):
+            for student in range(rng.randint(3, 8)):
+                repo.ask(
+                    student,
+                    week,
+                    rng.randint(1, 4),
+                    doc=rng.choice([DOC_A, DOC_B]),
+                    kind=rng.choice(["cited", "cited", "retrieved", "none"]),
+                )
+        result = read(repo)
+        weeks = result.summary_weeks or []
+        covered = [a for a in repo.answered if a.answered_at.date() - timedelta(days=1) in weeks]
+        for week in (FIRST, SECOND):
+            if (count := cell(result, week)) is not None:
+                assert count == sum(
+                    q.asked_at.date() - timedelta(days=1) == week for q in repo.asked
+                )
+        if result.active_students is not None:
+            published += 1
+            assert result.active_students == len({a.student_id for a in covered})
+        if result.no_material_rate is not None:
+            assert result.no_material_rate == round(
+                sum(not a.sources for a in covered) / len(covered), 3
+            )
+        for document in result.documents:
+            if document.cited_appearances is not None:
+                assert document.cited_appearances == sum(
+                    a.content == CITED
+                    and any(s.document_id == document.document_id for s in a.sources)
+                    for a in covered
+                )
+    assert published >= 30
+
+
+# --- small classes -----------------------------------------------------------------------------
+
+
+def test_four_active_students_give_no_summary_figure_and_keep_the_enrolled_count() -> None:
+    repo = Repo()
+    balanced(repo, FIRST, people=4)
+    balanced(repo, SECOND, people=4)
+
+    result = read(repo)
+
+    assert result.summary_window is not None and result.summary_weeks is None
+    assert result.active_students is None and result.no_material_rate is None
+    assert result.no_cited_source_rate is None
+    assert [d.cited_appearances for d in result.documents] == [None]
+    assert result.enrolled_students == len(PEOPLE) and result.suppressed
+
+
+def test_five_balanced_students_are_enough() -> None:
+    repo = Repo()
+    balanced(repo, SECOND)
+
+    result = read(repo)
+
+    assert (result.summary_weeks, result.active_students) == ([SECOND], 5)
+    assert figure(result, DOC_A) == 10
+
+
+# --- rule G3 (V6b) -----------------------------------------------------------------------------
+
+
+def three_documents() -> Repo:
+    """Six students cite A, and six have answers that only retrieved and without material, so that
+    both rates can be published; documents B and C exist."""
+    repo = Repo({DOC_A: "a.pdf", DOC_B: "b.pdf", DOC_C: "c.pdf"})
+    balanced(repo, SECOND, people=6, each=3, doc=DOC_A)
+    balanced(repo, SECOND, people=6, each=1, kind="retrieved")
+    balanced(repo, SECOND, people=6, each=1, kind="none")
+    return repo
+
+
+def test_one_withheld_cited_document_withholds_only_the_uncited_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=3, each=1, doc=DOC_B)
+
+    result = read(repo)
+
+    assert result.no_cited_source_rate is None  # B alone could be computed from it
+    assert result.no_material_rate == round(6 / 33, 3) and result.active_students == 6
+    assert (figure(result, DOC_A), figure(result, DOC_B)) == (18, None)
+    assert result.suppressed
+
+
+def test_enough_students_behind_the_withheld_documents_keep_the_uncited_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=3, each=1, doc=DOC_B)
+    for student in (3, 4, 5):
+        repo.ask(student, SECOND, 1, doc=DOC_C)
+
+    result = read(repo)
+
+    assert figure(result, DOC_B) is None and figure(result, DOC_C) is None
+    assert result.no_cited_source_rate == round(12 / 36, 3)  # six students behind B and C
+
+
+def test_a_document_without_appearances_does_not_count() -> None:
+    repo = three_documents()  # C is a new document: null, never cited
+    balanced(repo, SECOND, people=3, each=1, doc=DOC_B)
+
+    result = read(repo)
+
+    assert figure(result, DOC_C) is None
+    assert result.no_cited_source_rate is None
+
+
+def test_unused_documents_alone_keep_the_uncited_rate() -> None:
+    assert read(three_documents()).no_cited_source_rate == round(12 / 30, 3)
+
+
+def test_a_document_withheld_for_dominance_counts() -> None:
+    repo = three_documents()
+    for student in range(5):
+        repo.ask(student, SECOND, 5 if student == 0 else 1, doc=DOC_B)
+    balanced(repo, SECOND, people=6, each=6, doc=DOC_A)  # keeps the cell balanced
+
+    result = read(repo)
+
+    assert figure(result, DOC_B) is None and cell(result, SECOND) is not None
+    assert result.no_cited_source_rate is None and result.no_material_rate is not None
+
+
+def test_any_cited_deleted_document_withholds_the_uncited_rate_and_is_not_listed() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=6, each=1, doc=None, name="old.pdf")
+
+    result = read(repo)
+
+    assert result.no_cited_source_rate is None and result.no_material_rate == round(6 / 36, 3)
+    assert [d.filename for d in result.documents] == ["a.pdf", "b.pdf", "c.pdf"]
+    assert all(d.document_id is not None for d in result.documents)
+
+
+def test_a_deleted_document_that_was_only_retrieved_does_not_withhold_the_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=6, each=1, doc=None, kind="retrieved")
+
+    assert read(repo).no_cited_source_rate == round(18 / 36, 3)
+
+
+def test_the_rule_does_not_depend_on_a_withheld_week() -> None:
+    one, two = three_documents(), three_documents()
+    balanced(one, FIRST, people=3, each=1, doc=DOC_B)
+    balanced(two, FIRST, people=4, each=2, doc=None, name="old.pdf")
+
+    assert read(one).model_dump(mode="json") == read(two).model_dump(mode="json")
+    assert read(one).no_cited_source_rate == round(12 / 30, 3)
+
+
+# --- deleting a document (V7) ------------------------------------------------------------------
+
+
+def test_two_documents_with_one_name_cannot_be_subtracted_after_deleting_them() -> None:
+    repo = Repo({DOC_A: "notes.pdf", DOC_B: "notes.pdf"})
+    balanced(repo, SECOND, people=6, each=1, doc=DOC_A)
+    balanced(repo, SECOND, people=3, each=1, doc=DOC_B)
+    before = read(repo)
+    assert sorted((figure(before, DOC_A), figure(before, DOC_B)), key=str) == [6, None]
+
+    repo.delete(DOC_A)
+    first = read(repo)
+    repo.delete(DOC_B)
+    both = read(repo)
+
+    assert [(d.document_id, d.cited_appearances) for d in first.documents] == [(DOC_B, None)]
+    assert both.documents == []
+    assert first.no_cited_source_rate is None and both.no_cited_source_rate is None
+
+
+def test_deleting_a_published_document_removes_it_and_changes_no_other_figure() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=6, each=1, doc=DOC_B)
+    before = read(repo)
+
+    repo.delete(DOC_B)
+    after = read(repo)
+
+    assert [d.filename for d in after.documents] == ["a.pdf", "c.pdf"]
+    assert figure(after, DOC_A) == figure(before, DOC_A)
+    assert before.no_cited_source_rate == round(12 / 36, 3) and after.no_cited_source_rate is None
+    assert (after.active_students, after.no_material_rate) == (
+        before.active_students,
+        before.no_material_rate,
+    )
+    assert [p.count for p in after.questions] == [p.count for p in before.questions]
+
+
+def gained(before: Any, after: Any) -> bool:
+    """A figure of `after` that `before` did not show with the same value."""
+    old = {d.document_id: d.cited_appearances for d in before.documents}
+    scalars = ("active_students", "no_material_rate", "no_cited_source_rate")
+    if any(getattr(after, f) not in (None, getattr(before, f)) for f in scalars):
+        return True
+    if [p.count for p in after.questions] != [p.count for p in before.questions]:
+        return True
+    return any(
+        d.document_id not in old or d.cited_appearances not in (None, old[d.document_id])
+        for d in after.documents
+    )
+
+
+def test_successive_deletions_never_show_anything_new() -> None:
+    merging = 0
+    for seed in range(120):
+        rng = random.Random(seed)
+        keys = [uuid.UUID(int=500 + n) for n in range(4)]
+        repo = Repo({key: rng.choice(["notes.pdf", "unit.pdf"]) for key in keys})
+        for student in range(rng.randint(5, 9)):
+            for _ in range(rng.randint(1, 4)):
+                repo.ask(
+                    student,
+                    SECOND,
+                    1,
+                    doc=rng.choice(keys),
+                    kind=rng.choice(["cited", "cited", "cited", "retrieved", "none"]),
+                )
+        names = dict(repo.documents)
+        reads = [read(repo)]
+        deleted = rng.sample(keys, rng.randint(2, 4))
+        for key in deleted:
+            repo.delete(key)
+            reads.append(read(repo))
+        merging += len({names[k] for k in deleted}) < len(deleted)
+        for before, after in zip(reads, reads[1:], strict=False):
+            assert not gained(before, after), seed
+    assert merging >= 80
