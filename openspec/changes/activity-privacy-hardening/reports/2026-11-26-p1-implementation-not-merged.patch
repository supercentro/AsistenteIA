@@ -0,0 +1,296 @@
+"""Compositions of the published figures: what P1 closes and what stays open.
+
+The exhaustive adversary (`tests/composition_oracle.py`) looks for **any** determined quantity
+of few students. As in `test_activity_inference_vectors.py`: a `*_is_reproduced` test asserts a
+leak that is still open, so PASS means the weakness is confirmed; its property is
+`xfail(strict=True)`, so the day it passes the marker and TD-069 are reviewed. Fictitious data.
+"""
+
+# The generators are seeded test data, never a secret: S311 does not apply to this module.
+# ruff: noqa: S311
+
+import random
+from collections import Counter
+from typing import Any
+
+import pytest
+
+from app.repositories.activity_repository import AnswerFact, QuestionFact, SourceFact
+from tests.composition_oracle import DOCUMENTS, determined, facts, random_class
+from tests.unit.test_activity_composition import (
+    DOC_A,
+    DOC_B,
+    DOC_C,
+    FIRST,
+    PEOPLE,
+    SECOND,
+    Repo,
+    balanced,
+    cell,
+    figure,
+    read,
+)
+
+# What stays open (D-Q23): the complements of the document figures (V8 to V10).
+OPEN = {
+    "complement of documents",
+    "cited outside documents",
+    "with material outside documents",
+}
+
+
+def test_no_hidden_document_rate_side_or_difference_is_determined() -> None:
+    """Every world consistent with each response is enumerated. Counts what triggers it.
+
+    It does **not** assert that nothing is determined: the complements of the document figures and
+    some determined zeros are open, and the test requires that the adversary keeps finding them.
+    """
+    reads = with_hidden = no_material = uncited = both = 0
+    found: Counter[str] = Counter()
+    still_open: Counter[str] = Counter()
+    for max_cites in (1, 2):
+        rng = random.Random(7)
+        for number in range(300):
+            rows = random_class(rng, max_cites, mixed=number % 2 == 0)
+            repo = Repo({key: f"{n}.pdf" for n, key in enumerate(DOCUMENTS)})
+            repo.asked, repo.answered = facts(rows)
+            result = read(repo)
+            if result.summary_weeks is None:
+                continue
+            reads += 1
+            with_hidden += any(d.cited_appearances is None for d in result.documents)
+            no_material += result.no_material_rate is not None
+            uncited += result.no_cited_source_rate is not None
+            both += result.no_material_rate is not None and result.no_cited_source_rate is not None
+            # The rates and cells alone must determine nothing, not even a zero.
+            without_documents = result.model_copy(update={"documents": []})
+            assert determined(rows, without_documents, max_cites) == set(), (max_cites, number)
+            for name in determined(rows, result, max_cites):
+                is_open = name.startswith("none: ") or name in OPEN
+                (still_open if is_open else found)[name] += 1
+    assert not found, found
+    assert reads >= 500 and with_hidden >= 300
+    assert no_material >= 100 and uncited >= 80 and both >= 30, (no_material, uncited, both)
+    # V10 with a non-zero value is rare in random classes: its scenario is below.
+    for name in (
+        "complement of documents",
+        "with material outside documents",
+        "none: hidden document",
+        "none: cited outside documents",
+    ):
+        assert still_open[name] >= 5, still_open
+
+
+def cite_two(repo: Repo, student: int) -> None:
+    """One answer that cites documents B and C."""
+    repo.ask(student, SECOND, 1, answered=False)
+    asked: QuestionFact = repo.asked[-1]
+    sources = (SourceFact(1, DOC_B, "b.pdf"), SourceFact(2, DOC_C, "c.pdf"))
+    repo.answered.append(
+        AnswerFact(PEOPLE[student], asked.asked_at, "Respuesta ficticia [1][2].", sources)
+    )
+
+
+# --- V6b, the cases of the first review (closed by G3) --------------------------------------------
+
+
+def three_documents() -> Repo:
+    return Repo({DOC_A: "a.pdf", DOC_B: "b.pdf", DOC_C: "c.pdf"})
+
+
+def test_one_answer_over_two_withheld_documents_does_not_give_the_uncited_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=6, each=2, kind="retrieved")
+    balanced(repo, SECOND, people=6, each=2)
+    cite_two(repo, 0)
+
+    result = read(repo)
+
+    assert figure(result, DOC_B) is None and figure(result, DOC_C) is None
+    assert result.no_cited_source_rate is None
+
+
+def test_one_account_beside_a_withheld_document_does_not_give_the_uncited_rate() -> None:
+    repo = three_documents()
+    balanced(repo, SECOND, people=6, each=2, doc=DOC_A)
+    balanced(repo, SECOND, people=6, each=1, kind="retrieved")
+    balanced(repo, SECOND, people=3, each=1, doc=DOC_B)
+    repo.ask(8, SECOND, 1, doc=DOC_C)
+
+    result = read(repo)
+
+    assert figure(result, DOC_B) is None
+    assert result.no_cited_source_rate is None
